# ---- Supabase (publishable / public config — safe to show as an example) ----
SUPABASE_PROJECT_ID="your_supabase_project_id"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
SUPABASE_URL="https://your-project.supabase.co"
# Service role key — bypasses RLS. SERVER-SIDE ONLY, never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."
VITE_SUPABASE_PROJECT_ID="your_supabase_project_id"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
VITE_SUPABASE_URL="https://your-project.supabase.co"
# Public URL used in Supabase email links. Set this to the deployed Vercel URL.
VITE_PUBLIC_APP_URL="https://your-app.vercel.app"

# ---- AI Provider ----
# Which backend groqChat() tries first: "groq" (default), "gemini" or "openrouter".
# If that provider has no key, or all its models fail, the client automatically
# falls through to the other providers that DO have a key configured.
AI_PROVIDER=groq

# Groq API key — SERVER-SIDE ONLY. Fastest inference, generous free tier.
# NEVER expose this through a VITE_ variable or any frontend/client code.
# Get your key at https://console.groq.com/keys
# Model: qwen/qwen3.8-27b (configured in src/lib/ai.server.ts)
# Add the real value in Project Settings → Secrets — do not commit real keys here.
GROQ_API_KEY=your_groq_api_key_here

# Google Gemini API key — SERVER-SIDE ONLY. Permanently free tier (~1M tokens/day),
# no credit card required. Best long-context headroom for full resumes + job
# descriptions, so it is the recommended second key to configure.
# Get your key at https://aistudio.google.com/apikey
# GOOGLE_API_KEY is also accepted as an alias.
# Model: gemini-3-flash-preview (configured in src/lib/ai.server.ts)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenRouter API key — SERVER-SIDE ONLY. Widest model selection, free-tier models.
# Get your key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ---- Optional persistent RAG intelligence engine ----
# Set this to true after applying the intelligence RAG migration. Without an
# embedding key, the app safely uses its existing deterministic retrieval.
RAG_EMBEDDINGS_ENABLED=true
RAG_AUTO_INDEX=true
# Gemini is used when GEMINI_API_KEY is configured. For Alibaba/OpenAI-compatible
# embeddings, set both custom values and return a 768-number embedding vector.
RAG_GEMINI_EMBEDDING_MODEL=gemini-embedding-001
RAG_EMBEDDING_URL=
RAG_EMBEDDING_API_KEY=
RAG_EMBEDDING_MODEL=

# ---- Tavily (server-side secret) ----
# NEVER expose this through a VITE_ variable or any frontend/client code.
# Only read it inside server functions / server routes via process.env['TAVILY_API_KEY'].
TAVILY_API_KEY=your_tavily_api_key_here
